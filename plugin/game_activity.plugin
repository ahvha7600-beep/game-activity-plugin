# game_activity.plugin
# Локальный блок игровой активности (игра, иконка, Playing, таймер)
import os
import json
import threading
import time
from datetime import datetime, timezone
from typing import Any

from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import run_on_queue
from android_utils import log
from ui.settings import Header, Input, Divider

# Команды (можете изменить через create_settings если нужно)
DEFAULT_SET_CMD = ".setgame"
DEFAULT_STOP_CMD = ".stopgame"
DEFAULT_CHANGE_CMD = ".changegame"

__id__ = "game_activity_local"
__name__ = "Game Activity (локально)"
__description__ = "Локальный блок игровой активности: иконка, название, Playing, таймер"
__author__ = "@generated"
__version__ = "1.0.0"
__min_version__ = "11.12.0"
__icon__ = "xelivet_by_fStikBot/67"


class GameActivityPlugin(BasePlugin):
    """
    Плагин предоставляет:
      - set_game(name) — выбрать игру и запустить таймер
      - stop_game() — остановить таймер и скрыть блок
      - change_game(name) — сменить игру (сброс таймера)
    Управление через чат-команды:
      .setgame <name>
      .stopgame
      .changegame <name>
    """

    def has_settings(self):
        return True

    def create_settings(self):
        # Простые настройки для изменения команд (при желании)
        return [
            Header(text="Commands (chat)"),
            Input(key="set_cmd", text="Set game command", default=DEFAULT_SET_CMD),
            Input(key="stop_cmd", text="Stop game command", default=DEFAULT_STOP_CMD),
            Input(key="change_cmd", text="Change game command", default=DEFAULT_CHANGE_CMD),
            Divider(),
            Header(text="Notes"),
            Input(key="icons_dir_hint", text="Icons directory (relative to plugin file). Default = icons/", default="icons")
        ]

    def on_plugin_load(self):
        # Путь к storage JSON рядом с файлом плагина
        self.storage_path = os.path.join(os.path.dirname(__file__), "game_activity_state.json")
        # По умолчанию ищем icons/ в родительской папке или рядом с плагином
        plugin_dir = os.path.dirname(__file__)
        parent_icons = os.path.abspath(os.path.join(plugin_dir, "..", "icons"))
        local_icons = os.path.abspath(os.path.join(plugin_dir, "icons"))
        if os.path.isdir(local_icons):
            self.icons_dir = local_icons
        elif os.path.isdir(parent_icons):
            self.icons_dir = parent_icons
        else:
            # случай, если папки нет — всё равно используем local_icons path (его можно создать)
            self.icons_dir = local_icons

        self._lock = threading.Lock()
        self._timer_thread = None
        self._stop_event = threading.Event()

        # state: {"active": bool, "name": str or None, "start_ts": float or None}
        self.state = {"active": False, "name": None, "start_ts": None}
        self._load_state()

        # Регистрируем хук на отправку сообщений (как в примере lichess_invite)
        try:
            self.add_on_send_message_hook()
        except Exception:
            # some clients may use different registration; log and continue
            pass

        log("game_activity plugin loaded")

        # Если ранее была активная игра — возобновляем блок/таймер
        if self.state.get("active") and self.state.get("name") and self.state.get("start_ts"):
            # показать блок и запустить таймер
            self._show_block_resume()

    # --------------------------
    # Public API methods
    # --------------------------
    def set_game(self, name: str):
        """
        Выбрать игру и запустить таймер (сброс времени).
        """
        with self._lock:
            self.state["name"] = name
            self.state["start_ts"] = datetime.now(timezone.utc).timestamp()
            self.state["active"] = True
            self._save_state()
            icon = self._find_icon_for_game(name)
            title = name
            status_text = "Playing"
            timer_text = self._format_elapsed(0)
            # Показать блок в UI клиента
            self._client_show_block(icon, title, status_text, timer_text)
            self._start_timer_thread()

    def stop_game(self):
        """
        Остановить таймер и скрыть блок.
        """
        with self._lock:
            self.state["active"] = False
            self.state["name"] = None
            self.state["start_ts"] = None
            self._save_state()
            self._stop_timer_thread()
            self._client_hide_block()

    def change_game(self, name: str):
        """
        Сменить игру (аналогично set_game).
        """
        self.set_game(name)

    # --------------------------
    # Message hook — команды в чате
    # --------------------------
    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        # params.message expected to be str
        if not isinstance(params.message, str):
            return HookResult()

        text = params.message.strip()
        set_cmd = self.get_setting("set_cmd", DEFAULT_SET_CMD).strip()
        stop_cmd = self.get_setting("stop_cmd", DEFAULT_STOP_CMD).strip()
        change_cmd = self.get_setting("change_cmd", DEFAULT_CHANGE_CMD).strip()

        lower = text.lower()
        # .setgame <name>
        if lower.startswith(set_cmd):
            parts = text.split(maxsplit=1)
            if len(parts) == 2 and parts[1].strip():
                name = parts[1].strip()
                run_on_queue(lambda: self.set_game(name))
                # скрываем исходное сообщение (поведение как в примере — cancel)
                return HookResult(strategy=HookStrategy.CANCEL)
            else:
                # можно показать подсказку (через лог)
                log("Usage: {} <game name>".format(set_cmd))
                return HookResult()

        # .changegame <name>
        if lower.startswith(change_cmd):
            parts = text.split(maxsplit=1)
            if len(parts) == 2 and parts[1].strip():
                name = parts[1].strip()
                run_on_queue(lambda: self.change_game(name))
                return HookResult(strategy=HookStrategy.CANCEL)
            else:
                log("Usage: {} <game name>".format(change_cmd))
                return HookResult()

        # .stopgame
        if lower == stop_cmd:
            run_on_queue(lambda: self.stop_game())
            return HookResult(strategy=HookStrategy.CANCEL)

        return HookResult()

    # --------------------------
    # Internal: icon search / formatting / timer
    # --------------------------
    def _find_icon_for_game(self, name: str) -> str:
        """
        Поиск иконки в icons_dir.
        Поддерживаются расширения: png, jpg, jpeg, webp, svg.
        Возвращает путь или пустую строку.
        """
        if not name:
            return ""
        # попытки в разных вариантах
        candidates = []
        if os.path.isdir(self.icons_dir):
            for ext in ("png", "jpg", "jpeg", "webp", "svg"):
                path = os.path.join(self.icons_dir, f"{name}.{ext}")
                if os.path.isfile(path):
                    candidates.append(path)
            # try lowercase/underscored
            safe = name.lower().replace(" ", "_")
            for ext in ("png", "jpg", "jpeg", "webp", "svg"):
                path = os.path.join(self.icons_dir, f"{safe}.{ext}")
                if os.path.isfile(path):
                    candidates.append(path)
        if candidates:
            return candidates[0]
        return ""

    def _format_elapsed(self, seconds: int) -> str:
        hrs, rem = divmod(int(seconds), 3600)
        mins, secs = divmod(rem, 60)
        if hrs:
            return f"{hrs:d}:{mins:02d}:{secs:02d}"
        else:
            return f"{mins:d}:{secs:02d}"

    def _start_timer_thread(self):
        self._stop_event.clear()
        if self._timer_thread and self._timer_thread.is_alive():
            return
        self._timer_thread = threading.Thread(target=self._run_timer_loop, daemon=True)
        self._timer_thread.start()

    def _stop_timer_thread(self):
        self._stop_event.set()
        if self._timer_thread:
            self._timer_thread.join(timeout=1)
        self._timer_thread = None
        self._stop_event.clear()

    def _run_timer_loop(self):
        while not self._stop_event.is_set():
            with self._lock:
                if not self.state.get("active") or not self.state.get("start_ts"):
                    break
                elapsed = time.time() - float(self.state["start_ts"])
                timer_text = self._format_elapsed(elapsed)
            # Обновляем UI
            try:
                self._client_update_block(timer_text)
            except Exception:
                # игнорируем ошибки адаптера
                pass
            # интервал ~1s, но прерываемся чаще для отзывчивости
            for _ in range(10):
                if self._stop_event.is_set():
                    break
                time.sleep(0.1)

    def _show_block_resume(self):
        name = self.state.get("name")
        start_ts = self.state.get("start_ts")
        if not name or not start_ts:
            return
        icon = self._find_icon_for_game(name)
        title = name
        status_text = "Playing"
        elapsed = time.time() - float(start_ts)
        timer_text = self._format_elapsed(elapsed)
        self._client_show_block(icon, title, status_text, timer_text)
        self._start_timer_thread()

    # --------------------------
    # Client UI integration (attempts common API names, fallback to log)
    # --------------------------
    def _client_show_block(self, icon_path: str, title: str, status_text: str, timer_text: str):
        """
        Попытка создать локальный профильный блок через типичные имена API.
        Поддерживаемые варианты (попробуем по порядку):
          - self.set_local_profile_card(dict)
          - self.client.set_local_profile_card(dict)
          - global function set_local_profile_card (если доступна)
        Если ничего не найдено — логируем (fallback).
        """
        payload = {
            "id": "local_game_activity_block",
            "icon": icon_path or "",
            "title": title or "",
            "text": status_text or "",
            "right_text": timer_text or ""
        }
        try:
            # 1) метод в самом плагине (в некоторых реализациях)
            if hasattr(self, "set_local_profile_card"):
                try:
                    self.set_local_profile_card(payload)
                    return
                except Exception:
                    pass
            # 2) объект client (часто доступен)
            client = getattr(self, "client", None)
            if client:
                if hasattr(client, "set_local_profile_card"):
                    try:
                        client.set_local_profile_card(payload)
                        return
                    except Exception:
                        pass
                # некоторые клиенты предоставляют create_local_profile_card
                if hasattr(client, "create_local_profile_card"):
                    try:
                        client.create_local_profile_card(payload)
                        return
                    except Exception:
                        pass
            # 3) глобальные функции (редко)
            try:
                from client_utils import set_local_profile_card as global_set
                global_set(payload)
                return
            except Exception:
                pass
        except Exception:
            pass

        # fallback: лог
        log(f"[game_activity] show: {title} | {status_text} | {timer_text} | icon={icon_path}")

    def _client_update_block(self, timer_text: str):
        """
        Попытка обновить только правый текст/таймер блока.
        """
        try:
            if hasattr(self, "update_local_profile_card"):
                try:
                    self.update_local_profile_card("local_game_activity_block", {"right_text": timer_text})
                    return
                except Exception:
                    pass
            client = getattr(self, "client", None)
            if client:
                if hasattr(client, "update_local_profile_card"):
                    try:
                        client.update_local_profile_card("local_game_activity_block", {"right_text": timer_text})
                        return
                    except Exception:
                        pass
            # глобальная попытка
            try:
                from client_utils import update_local_profile_card as global_update
                global_update("local_game_activity_block", {"right_text": timer_text})
                return
            except Exception:
                pass
        except Exception:
            pass

        # fallback: лог
        log(f"[game_activity] update timer: {timer_text}")

    def _client_hide_block(self):
        """
        Удалить локальный блок.
        """
        try:
            if hasattr(self, "remove_local_profile_card"):
                try:
                    self.remove_local_profile_card("local_game_activity_block")
                    return
                except Exception:
                    pass
            client = getattr(self, "client", None)
            if client and hasattr(client, "remove_local_profile_card"):
                try:
                    client.remove_local_profile_card("local_game_activity_block")
                    return
                except Exception:
                    pass
            try:
                from client_utils import remove_local_profile_card as global_remove
                global_remove("local_game_activity_block")
                return
            except Exception:
                pass
        except Exception:
            pass

        log("[game_activity] hide block")

    # --------------------------
    # State persistence
    # --------------------------
    def _save_state(self):
        try:
            tmp = self.storage_path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.state, f, ensure_ascii=False, indent=2)
            os.replace(tmp, self.storage_path)
        except Exception as e:
            log(f"[game_activity] save error: {e}")

    def _load_state(self):
        try:
            if os.path.isfile(self.storage_path):
                with open(self.storage_path, "r", encoding="utf-8") as f:
                    self.state = json.load(f)
        except Exception:
            self.state = {"active": False, "name": None, "start_ts": None}
