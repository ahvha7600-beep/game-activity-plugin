# game_activity.plugin
# Локальный блок игровой активности (игра, иконка, Playing, таймер)
import os
import json
import threading
import time
from datetime import datetime, timezone
from typing import Any

from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import run_on_queue
from android_utils import log
from ui.settings import Header, Input, Divider

# Команды (можете изменить через create_settings если нужно)
DEFAULT_SET_CMD = ".setgame"
DEFAULT_STOP_CMD = ".stopgame"
DEFAULT_CHANGE_CMD = ".changegame"

__id__ = "game_activity_local"
__name__ = "Game Activity"
__description__ = "Локальный блок игровой активности: иконка, название, Playing, таймер"
__author__ = "@h3sny"
__version__ = "1.0.1"
__min_version__ = "11.12.0"
__icon__ = "xelivet_by_fStikBot/67"


class GameActivityPlugin(BasePlugin):
    """
    Плагин предоставляет:
      - set_game(name) — выбрать игру и запустить таймер
      - stop_game() — остановить таймер и скрыть блок
      - change_game(name) — сменить игру (сброс таймера)
    """

    def has_settings(self):
        return True

    def create_settings(self):
        return [
            Header(text="Commands (chat)"),
            Input(key="set_cmd", text="Set game command", default=DEFAULT_SET_CMD),
            Input(key="stop_cmd", text="Stop game command", default=DEFAULT_STOP_CMD),
            Input(key="change_cmd", text="Change game command", default=DEFAULT_CHANGE_CMD),
            Divider(),
            Header(text="Notes"),
            Input(key="icons_dir_hint", text="Icons directory (relative to plugin file). Default = icons", default="icons")
        ]

    def on_plugin_load(self):
        # Путь к storage JSON рядом с файлом плагина
        self.storage_path = os.path.join(os.path.dirname(__file__), "game_activity_state.json")
        # По умолчанию ищем icons/ в родительской папке или рядом с плагином
        plugin_dir = os.path.dirname(__file__)
        parent_icons = os.path.abspath(os.path.join(plugin_dir, "..", "icons"))
        local_icons = os.path.abspath(os.path.join(plugin_dir, "icons"))
        if os.path.isdir(local_icons):
            self.icons_dir = local_icons
        elif os.path.isdir(parent_icons):
            self.icons_dir = parent_icons
        else:
            self.icons_dir = local_icons

        self._lock = threading.Lock()
        self._timer_thread = None
        self._stop_event = threading.Event()

        # state: {"active": bool, "name": str or None, "start_ts": float or None}
        self.state = {"active": False, "name": None, "start_ts": None}
        self._load_state()

        # Регистрируем хук на отправку сообщений
        try:
            self.add_on_send_message_hook()
        except Exception:
            pass

        log("game_activity plugin loaded")

        # ДОП: логируем доступные API для диагностики
        try:
            self._log_available_apis()
        except Exception:
            pass

        # Если ранее была активная игра — возобновляем блок/таймер
        if self.state.get("active") and self.state.get("name") and self.state.get("start_ts"):
            self._show_block_resume()

    # --------------------------
    # Public API methods
    # --------------------------
    def set_game(self, name: str):
        with self._lock:
            self.state["name"] = name
            self.state["start_ts"] = datetime.now(timezone.utc).timestamp()
            self.state["active"] = True
            self._save_state()
            icon = self._find_icon_for_game(name)
            title = name
            status_text = "Playing"
            timer_text = self._format_elapsed(0)
            self._client_show_block(icon, title, status_text, timer_text)
            self._start_timer_thread()

    def stop_game(self):
        with self._lock:
            self.state["active"] = False
            self.state["name"] = None
            self.state["start_ts"] = None
            self._save_state()
            self._stop_timer_thread()
            self._client_hide_block()

    def change_game(self, name: str):
        self.set_game(name)

    # --------------------------
    # Message hook — команды в чате
    # --------------------------
    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not isinstance(params.message, str):
            return HookResult()

        text = params.message.strip()
        set_cmd = self.get_setting("set_cmd", DEFAULT_SET_CMD).strip()
        stop_cmd = self.get_setting("stop_cmd", DEFAULT_STOP_CMD).strip()
        change_cmd = self.get_setting("change_cmd", DEFAULT_CHANGE_CMD).strip()

        lower = text.lower()
        if lower.startswith(set_cmd):
            parts = text.split(maxsplit=1)
            if len(parts) == 2 and parts[1].strip():
                name = parts[1].strip()
                run_on_queue(lambda: self.set_game(name))
                return HookResult(strategy=HookStrategy.CANCEL)
            else:
                log("Usage: {} <game name>".format(set_cmd))
                return HookResult()

        if lower.startswith(change_cmd):
            parts = text.split(maxsplit=1)
            if len(parts) == 2 and parts[1].strip():
                name = parts[1].strip()
                run_on_queue(lambda: self.change_game(name))
                return HookResult(strategy=HookStrategy.CANCEL)
            else:
                log("Usage: {} <game name>".format(change_cmd))
                return HookResult()

        if lower == stop_cmd:
            run_on_queue(lambda: self.stop_game())
            return HookResult(strategy=HookStrategy.CANCEL)

        return HookResult()

    # --------------------------
    # Internal: icon search / formatting / timer
    # --------------------------
    def _find_icon_for_game(self, name: str) -> str:
        if not name:
            return ""
        candidates = []
        if os.path.isdir(self.icons_dir):
            for ext in ("png", "jpg", "jpeg", "webp", "svg"):
                path = os.path.join(self.icons_dir, f"{name}.{ext}")
                if os.path.isfile(path):
                    candidates.append(path)
            safe = name.lower().replace(" ", "_")
            for ext in ("png", "jpg", "jpeg", "webp", "svg"):
                path = os.path.join(self.icons_dir, f"{safe}.{ext}")
                if os.path.isfile(path):
                    candidates.append(path)
        if candidates:
            return candidates[0]
        return ""

    def _format_elapsed(self, seconds: int) -> str:
        hrs, rem = divmod(int(seconds), 3600)
        mins, secs = divmod(rem, 60)
        if hrs:
            return f"{hrs:d}:{mins:02d}:{secs:02d}"
        else:
            return f"{mins:d}:{secs:02d}"

    def _start_timer_thread(self):
        self._stop_event.clear()
        if self._timer_thread and self._timer_thread.is_alive():
            return
        self._timer_thread = threading.Thread(target=self._run_timer_loop, daemon=True)
        self._timer_thread.start()

    def _stop_timer_thread(self):
        self._stop_event.set()
        if self._timer_thread:
            self._timer_thread.join(timeout=1)
        self._timer_thread = None
        self._stop_event.clear()

    def _run_timer_loop(self):
        while not self._stop_event.is_set():
            with self._lock:
                if not self.state.get("active") or not self.state.get("start_ts"):
                    break
                elapsed = time.time() - float(self.state["start_ts"])
                timer_text = self._format_elapsed(elapsed)
            try:
                self._client_update_block(timer_text)
            except Exception:
                pass
            for _ in range(10):
                if self._stop_event.is_set():
                    break
                time.sleep(0.1)

    def _show_block_resume(self):
        name = self.state.get("name")
        start_ts = self.state.get("start_ts")
        if not name or not start_ts:
            return
        icon = self._find_icon_for_game(name)
        title = name
        status_text = "Playing"
        elapsed = time.time() - float(start_ts)
        timer_text = self._format_elapsed(elapsed)
        self._client_show_block(icon, title, status_text, timer_text)
        self._start_timer_thread()

    # --------------------------
    # Debug / API detection
    # --------------------------
    def _log_available_apis(self):
        """
        Логируем доступные атрибуты self и client для диагностики.
        Вывод читается мной, чтобы адаптировать вызовы.
        """
        try:
            client = getattr(self, "client", None)
            log("[game_activity][API DETECT] self attributes:")
            try:
                sa = sorted([a for a in dir(self) if not a.startswith("_")])
                log(f"[game_activity][API DETECT] self: {', '.join(sa)}")
            except Exception:
                pass

            if client is None:
                log("[game_activity][API DETECT] no self.client attribute")
            else:
                try:
                    ca = sorted([a for a in dir(client) if not a.startswith("_")])
                    log(f"[game_activity][API DETECT] client attrs: {', '.join(ca)}")
                except Exception:
                    log("[game_activity][API DETECT] cannot list client attrs")
            # попробуем обнаружить популярные имена методов и залогировать их
            candidate_names = [
                "set_local_profile_card", "create_local_profile_card", "update_local_profile_card", "remove_local_profile_card",
                "setProfileCard", "createProfileCard", "updateProfileCard", "removeProfileCard",
                "set_profile_card", "create_profile_card", "update_profile_card", "remove_profile_card",
                "set_profile", "setProfile", "set_user_card", "show_local_card", "set_custom_status", "set_status", "set_bio", "setBio"
            ]
            found = []
            for name in candidate_names:
                if hasattr(self, name) or (client and hasattr(client, name)):
                    found.append(name)
            log(f"[game_activity][API DETECT] candidate methods found: {', '.join(found) if found else '(none)'}")
        except Exception as e:
            log(f"[game_activity][API DETECT] detection error: {e}")

    # --------------------------
    # Client UI integration (расширенные попытки)
    # --------------------------
    def _safe_call(self, obj, name, *args, **kwargs):
        """
        Безопасно вызывает obj.name(*args, **kwargs) если доступно.
        Логирует попытку и результат/исключение.
        Возвращает (True, result) если вызов выполнен без исключения, иначе (False, None).
        """
        try:
            func = getattr(obj, name, None)
            if callable(func):
                log(f"[game_activity][CALL ATTEMPT] calling {obj}.{name} with args={args} kwargs={kwargs}")
                res = func(*args, **kwargs)
                log(f"[game_activity][CALL ATTEMPT] {name} returned: {type(res)}")
                return True, res
            else:
                return False, None
        except Exception as e:
            log(f"[game_activity][CALL ATTEMPT] {name} raised: {e}")
            return False, None

    def _client_show_block(self, icon_path: str, title: str, status_text: str, timer_text: str):
        payload = {
            "id": "local_game_activity_block",
            "icon": icon_path or "",
            "title": title or "",
            "text": status_text or "",
            "right_text": timer_text or ""
        }
        # 1) try methods on self
        tried = False
        for name in ("set_local_profile_card", "create_local_profile_card", "set_profile_card", "create_profile_card", "setProfileCard"):
            ok, _ = self._safe_call(self, name, payload)
            if ok:
                tried = True
                break
        if tried:
            return

        # 2) try on client object
        client = getattr(self, "client", None)
        if client:
            for name in ("set_local_profile_card", "create_local_profile_card", "create_local_profile_card", "setProfileCard", "createProfileCard", "show_local_card", "set_profile"):
                ok, _ = self._safe_call(client, name, payload)
                if ok:
                    tried = True
                    break
        if tried:
            return

        # 3) try global helpers in client_utils
        try:
            import client_utils as cu
            for name in ("set_local_profile_card", "create_local_profile_card", "set_profile_card"):
                ok, _ = self._safe_call(cu, name, payload)
                if ok:
                    tried = True
                    break
        except Exception:
            pass

        # fallback: лог
        log(f"[game_activity] show fallback -> {title} | {status_text} | {timer_text} | icon={icon_path}")

    def _client_update_block(self, timer_text: str):
        fields = {"right_text": timer_text}
        tried = False
        for name in ("update_local_profile_card", "updateProfileCard", "update_profile_card"):
            ok, _ = self._safe_call(self, name, "local_game_activity_block", fields)
            if ok:
                tried = True
                break
        if tried:
            return

        client = getattr(self, "client", None)
        if client:
            for name in ("update_local_profile_card", "updateProfileCard", "update_profile_card"):
                ok, _ = self._safe_call(client, name, "local_game_activity_block", fields)
                if ok:
                    tried = True
                    break
        if tried:
            return

        try:
            import client_utils as cu
            for name in ("update_local_profile_card", "update_profile_card"):
                ok, _ = self._safe_call(cu, name, "local_game_activity_block", fields)
                if ok:
                    tried = True
                    break
        except Exception:
            pass

        log(f"[game_activity] update fallback -> timer={timer_text}")

    def _client_hide_block(self):
        tried = False
        for name in ("remove_local_profile_card", "removeProfileCard", "remove_profile_card"):
            ok, _ = self._safe_call(self, name, "local_game_activity_block")
            if ok:
                tried = True
                break
        if tried:
            return

        client = getattr(self, "client", None)
        if client:
            for name in ("remove_local_profile_card", "removeProfileCard", "remove_profile_card"):
                ok, _ = self._safe_call(client, name, "local_game_activity_block")
                if ok:
                    tried = True
                    break
        if tried:
            return

        try:
            import client_utils as cu
            for name in ("remove_local_profile_card", "remove_profile_card"):
                ok, _ = self._safe_call(cu, name, "local_game_activity_block")
                if ok:
                    tried = True
                    break
        except Exception:
            pass

        log("[game_activity] hide fallback")

    # --------------------------
    # State persistence
    # --------------------------
    def _save_state(self):
        try:
            tmp = self.storage_path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.state, f, ensure_ascii=False, indent=2)
            os.replace(tmp, self.storage_path)
        except Exception as e:
            log(f"[game_activity] save error: {e}")

    def _load_state(self):
        try:
            if os.path.isfile(self.storage_path):
                with open(self.storage_path, "r", encoding="utf-8") as f:
                    self.state = json.load(f)
        except Exception:
            self.state = {"active": False, "name": None, "start_ts": None}
